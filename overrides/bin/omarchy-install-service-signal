#!/bin/sh
#
# omarchy-install-service-signal — install Signal (Install > Service > Signal).
#
# FreeBSD also packages this as signal-desktop, but the binary lives under
# LOCALBASE (/usr/local/bin), not the Arch FHS /usr/bin upstream launches.

set -eu

echo "Installing Signal..."
omarchy-pkg-add signal-desktop

echo "Opening Signal..."
setsid uwsm-app -- signal-desktop >/dev/null 2>&1 &

echo ""
echo "Signal has been installed."
