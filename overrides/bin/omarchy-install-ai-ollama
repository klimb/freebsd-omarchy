#!/bin/sh
#
# omarchy-install-ai-ollama — install Ollama on FreeBSD (Install > AI > Ollama).
#
# Upstream's action shells out to omarchy-install-app (pacman/AUR via
# omarchy-pkg-add) and picks between ollama-cuda/ollama-rocm/ollama by probing
# nvidia-smi/rocminfo. FreeBSD's port is a single misc/ollama with CPU/VULKAN
# build options instead of separate GPU packages, so just install "ollama".
# Escalates with doas, matching omarchy-pkg-install-freebsd.

set -eu

echo "Installing Ollama..."
doas pkg install -y ollama
