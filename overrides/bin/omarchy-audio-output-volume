#!/usr/local/bin/bash

# omarchy:summary=Adjust output volume via FreeBSD mixer(8) and show the OSD.
# omarchy:args=<raise|lower|mute-toggle|+N|-N>
#
# FreeBSD reimplementation of the PipeWire/pactl upstream. PipeWire exposes no
# sink on FreeBSD, so drive the OSS master (mixer(8) "vol") directly -- that is
# the real hardware volume for the default pcm device. Volumes are 0.00-1.00 on
# FreeBSD 13+ mixer; we work in whole percent. Volume changes show the level bar;
# mute shows a glyph + "Muted" label with no bar (matching the mic-mute OSD) so
# the muted state is unmistakable rather than a subtle icon swap.

set -u

action="${1:-}"
dev="${OMARCHY_MIXER_DEV:-vol}"

# Current volume as an integer percent (first channel).
read_vol() {
  mixer "$dev.volume" 2>/dev/null | sed -n 's/.*=\([0-9.][0-9.]*\).*/\1/p' |
    awk 'NR==1 { printf "%d", $1 * 100 + 0.5 }'
}

# Current volume as the raw 0.00-1.00 fraction (first channel).
read_frac() {
  mixer "$dev.volume" 2>/dev/null | sed -n 's/.*=\([0-9.][0-9.]*\).*/\1/p' | awk 'NR==1 { print $1 }'
}

is_muted() { [[ "$(mixer "$dev.mute" 2>/dev/null)" == *=on ]]; }

set_vol() {
  local pct=$1 frac
  ((pct < 0)) && pct=0
  ((pct > 100)) && pct=100
  frac=$(awk -v p="$pct" 'BEGIN { printf "%.2f", p / 100 }')
  mixer "$dev.volume=$frac" >/dev/null 2>&1
}

case "$action" in
status)
  # Machine-readable state for the QuickShell audio panel: "<frac> <on|off>".
  printf '%s %s\n' "$(read_frac)" "$(is_muted && echo on || echo off)"
  exit 0
  ;;
mute-toggle)
  mixer "$dev.mute=toggle" >/dev/null 2>&1
  if is_muted; then
    omarchy-osd -i volume-muted -m "Muted"
  else
    omarchy-osd -i volume-high -p "$(read_vol)"
  fi
  exit 0
  ;;
raise) delta="+5" ;;
lower) delta="-5" ;;
*)
  if [[ $action =~ ^[+-][0-9]+$ ]]; then
    delta="$action"
  elif [[ $action =~ ^[0-9]+$ ]]; then
    # Bare integer: set an absolute percentage without an OSD (the audio panel
    # slider provides its own UI, so it drives volume through this path).
    mixer "$dev.mute=off" >/dev/null 2>&1
    set_vol "$action"
    exit 0
  else
    echo "Usage: omarchy-audio-output-volume <raise|lower|mute-toggle|status|+N|-N|N>" >&2
    exit 1
  fi
  ;;
esac

dir="${delta:0:1}"
step="${delta:1}"
cur="$(read_vol)"; cur="${cur:-0}"
if [[ $dir == "+" ]]; then next=$((cur + step)); else next=$((cur - step)); fi

# Changing the volume implicitly unmutes, matching the upstream behavior.
mixer "$dev.mute=off" >/dev/null 2>&1
set_vol "$next"

percent="$(read_vol)"
if ((${percent:-0} == 0)); then
  icon="volume-muted"
else
  icon="volume-high"
fi

omarchy-osd -i "$icon" -p "${percent:-0}"
