#!/bin/sh
#
# omarchy-remove-ai-ollama — remove Ollama on FreeBSD (Remove > AI > Ollama).
#
# FreeBSD counterpart to omarchy-install-ai-ollama; upstream's
# omarchy-remove-ai-ollama shells out to pacman. Escalates with doas,
# matching omarchy-pkg-remove-freebsd.

set -eu

echo "Removing Ollama..."
doas pkg delete -y ollama
