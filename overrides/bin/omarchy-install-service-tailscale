#!/bin/sh
#
# omarchy-install-service-tailscale — install + bring up Tailscale, add its bar
# widget, and add a webapp shortcut to the admin console
# (Install > Service > Tailscale).
#
# Upstream uses sudo + raw systemctl throughout (this repo is doas-only, and
# tailscaled is a plain rc.d service, not systemd); mirrors the steps
# omarchy-setup-network-tailscale already does for the Setup > Network menu.
# The Taildrop-receive background service is a systemd user unit with no
# FreeBSD port yet, so it is skipped here (unchanged from that gap).

set -eu

echo "Installing Tailscale..."
omarchy-pkg-add tailscale

echo "Starting Tailscale..."
doas sysrc tailscaled_enable=YES
doas service tailscaled status >/dev/null 2>&1 || doas service tailscaled start
doas tailscale up --accept-routes

echo "Allowing $USER to manage Tailscale..."
doas tailscale set --operator="$USER"

echo "Adding Tailscale to the bar..."
omarchy plugin enable omarchy.tailscale --before omarchy.network 2>/dev/null || true

omarchy-webapp-install "Tailscale" "https://login.tailscale.com/admin/machines" \
	"https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/tailscale-light.png"
