JSONC

# 7. Interactive shell. Omarchy's aliases/prompt (e.g. `ls` -> eza --icons) live
# in its bash config; FreeBSD's default /bin/sh never loads them. Point the
# user's bash startup at Omarchy's bashrc (install.sh switches the login shell
# to bash). OMARCHY_PATH/PATH are set here first since Omarchy's env-bootstrap
# uses a Linux path that does not exist on FreeBSD.
log "Writing ~/.bashrc and ~/.bash_profile to load Omarchy's shell config"
for f in "$HOME/.bashrc" "$HOME/.bash_profile"; do
	[ -e "$f" ] && [ ! -e "$f.bak-$STAMP" ] && mv "$f" "$f.bak-$STAMP"
done
cat > "$HOME/.bashrc" <<'BASHRC'
# Omarchy on FreeBSD: set OMARCHY_PATH/PATH, then load Omarchy's bash config.
export OMARCHY_PATH="$HOME/.local/src/omarchy"
case ":$PATH:" in
	*":$OMARCHY_PATH/bin:"*) ;;
	*) export PATH="$OMARCHY_PATH/bin:$HOME/.local/bin:$PATH" ;;
esac
# Some login setups omit the LOCALBASE bins; make sure they're present.
case ":$PATH:" in
	*":/usr/local/bin:"*) ;;
	*) export PATH="$PATH:/usr/local/sbin:/usr/local/bin" ;;
esac
[ -r "$OMARCHY_PATH/default/bashrc" ] && . "$OMARCHY_PATH/default/bashrc"
BASHRC
cat > "$HOME/.bash_profile" <<'BASHPROFILE'
[ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"
BASHPROFILE

log "Done."
log "Add yourself to the video group (as root) if you have not yet:"
log "    pw groupmod video -m $(id -un)"
log "Then log in on a TTY and run: omarchy-session"
