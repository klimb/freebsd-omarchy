#!/bin/sh
#
# omarchy-setup — install Omarchy dotfiles into the current user's home and
# apply the FreeBSD path/command adaptations.
#
# Safe to re-run: existing configs are backed up to ~/.config/<name>.bak-<ts>.
#
# Environment overrides:
#   OMARCHY_REPO    git URL to clone       (default: https://github.com/omacom/omarchy)
#   OMARCHY_BRANCH  branch to check out    (default: quattro)
#   OMARCHY_SRC     local clone location   (default: ~/.local/src/omarchy)

set -eu

OMARCHY_REPO="${OMARCHY_REPO:-https://github.com/omacom/omarchy}"
OMARCHY_BRANCH="${OMARCHY_BRANCH:-quattro}"
OMARCHY_SRC="${OMARCHY_SRC:-$HOME/.local/src/omarchy}"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STAMP="$(date +%Y%m%d-%H%M%S)"

log() { printf '==> %s\n' "$*"; }

require() {
	command -v "$1" >/dev/null 2>&1 || {
		printf 'error: required command not found: %s\n' "$1" >&2
		exit 1
	}
}

require git

# 1. Fetch (or update) the Omarchy source tree.
if [ -d "$OMARCHY_SRC/.git" ]; then
	log "Updating Omarchy source in $OMARCHY_SRC"
	git -C "$OMARCHY_SRC" fetch --depth 1 origin "$OMARCHY_BRANCH"
	git -C "$OMARCHY_SRC" checkout -q "$OMARCHY_BRANCH"
	git -C "$OMARCHY_SRC" reset -q --hard "origin/$OMARCHY_BRANCH"
else
	log "Cloning $OMARCHY_REPO ($OMARCHY_BRANCH) into $OMARCHY_SRC"
	mkdir -p "$(dirname "$OMARCHY_SRC")"
	git clone --depth 1 -b "$OMARCHY_BRANCH" "$OMARCHY_REPO" "$OMARCHY_SRC"
fi

mkdir -p "$CONFIG_HOME"

# 2. Copy config subtrees into ~/.config, backing up anything already there.
#    We copy (not symlink) so the FreeBSD patches below don't dirty the clone.
CONFIG_DIRS="alacritty btop foot ghostty hypr imv kitty lazygit omarchy tmux waybar"
for name in $CONFIG_DIRS; do
	src="$OMARCHY_SRC/config/$name"
	[ -d "$src" ] || continue
	dst="$CONFIG_HOME/$name"
	if [ -e "$dst" ] || [ -L "$dst" ]; then
		log "Backing up existing $dst -> $dst.bak-$STAMP"
		mv "$dst" "$dst.bak-$STAMP"
	fi
	cp -R "$src" "$dst"
done

# Single-file configs.
for f in starship.toml chromium-flags.conf xdg-terminals.list; do
	src="$OMARCHY_SRC/config/$f"
	[ -f "$src" ] || continue
	dst="$CONFIG_HOME/$f"
	[ -e "$dst" ] && mv "$dst" "$dst.bak-$STAMP"
	cp "$src" "$dst"
done

# 3. Wayland session services + Linux-compat shims.
# Omarchy is built for Arch/systemd and calls Linux-only tools (uwsm-app,
# setsid, systemd-cat, flock, GNU base64). Provide small shims on ~/.local/bin
# (which omarchy-session puts on PATH) so the helper scripts run unchanged.
SHIM_DIR="$HOME/.local/bin"
mkdir -p "$SHIM_DIR"

write_shim() {
	name="$1"
	dst="$SHIM_DIR/$name"
	cat > "$dst"
	chmod +x "$dst"
	log "Installed $name shim to $SHIM_DIR"
}

# uwsm-app: Arch launches apps via `uwsm-app -- <cmd>`; just run the command.
write_shim uwsm-app <<'SHIM'
#!/bin/sh
[ "${1:-}" = "--" ] && shift
exec "$@"
SHIM

# uwsm: Arch's systemd session manager. Omarchy uses `uwsm stop` to end the
# session (omarchy-system-logout) and `uwsm app -- <cmd>` to launch apps. Map
# stop -> quit Hyprland (returns to the TTY); app -> run the command; ignore
# the rest (start/check/finalize) so logout and launches work on FreeBSD.
# This Hyprland uses the Lua dispatch API, so exit is hl.dsp.exit() (not `exit`).
write_shim uwsm <<'SHIM'
#!/bin/sh
case "${1:-}" in
	stop) exec hyprctl dispatch "hl.dsp.exit()" ;;
	app) shift; [ "${1:-}" = "--" ] && shift; exec "$@" ;;
	*) exit 0 ;;
esac
SHIM

# setsid: absent in FreeBSD base. Hyprland already reaps children, so drop
# setsid's flags and run the command directly.
write_shim setsid <<'SHIM'
#!/bin/sh
while [ $# -gt 0 ]; do
	case "$1" in
		-f|--fork|-w|--wait|-c|--ctty) shift ;;
		--) shift; break ;;
		-*) shift ;;
		*) break ;;
	esac
done
exec "$@"
SHIM

# systemd-cat: no journal on FreeBSD. Drop logging flags, exec the program so
# its output inherits the caller's stdio (Hyprland captures it).
write_shim systemd-cat <<'SHIM'
#!/bin/sh
while [ $# -gt 0 ]; do
	case "$1" in
		-t|--identifier|-p|--priority) shift 2 ;;
		--) shift; break ;;
		-*) shift ;;
		*) break ;;
	esac
done
exec "$@"
SHIM

# flock: FreeBSD base uses lockf, not flock. A child cannot hold a lock on a
# caller-owned fd, so provide best-effort no-op locking (returns "acquired").
# The file+command form is honored by running the command.
write_shim flock <<'SHIM'
#!/bin/sh
while [ $# -gt 0 ]; do
	case "$1" in
		-w|--timeout) shift 2 ;;
		-n|--nonblock|-x|--exclusive|-s|--shared|-u|--unlock|-w*|-E*) shift ;;
		--) shift; break ;;
		-*) shift ;;
		*) break ;;
	esac
done
[ $# -ge 1 ] && shift    # drop the fd/file operand
[ $# -ge 1 ] && exec "$@"
exit 0
SHIM

# base64: FreeBSD base lacks GNU base64; map the flags Omarchy uses to openssl.
write_shim base64 <<'SHIM'
#!/bin/sh
decode=0 file=""
while [ $# -gt 0 ]; do
	case "$1" in
		-d|--decode) decode=1; shift ;;
		-w|--wrap) shift 2 ;;
		-w*|--wrap=*|-i|--ignore-garbage) shift ;;
		--) shift; break ;;
		-*) shift ;;
		*) file="$1"; shift ;;
	esac
done
if [ "$decode" -eq 1 ]; then
	[ -n "$file" ] && exec openssl base64 -d -A -in "$file"
	exec openssl base64 -d -A
else
	[ -n "$file" ] && exec openssl base64 -A -in "$file"
	exec openssl base64 -A
fi
SHIM

# stat: Omarchy scripts use GNU `stat -c/--format` with %Y (mtime), %s (size),
# %a (perms). Translate those to FreeBSD `stat -f` (%m/%z/%Lp); pass any
# non-GNU invocation straight through to the base stat.
write_shim stat <<'SHIM'
#!/bin/sh
real=/usr/bin/stat
case " $* " in
	*" -c "*|*" --format "*|*" --format="*|*" -Lc "*|*-c%*|*-Lc%*) ;;
	*) exec "$real" "$@" ;;
esac
follow=""; fmt=""
while [ $# -gt 0 ]; do
	case "$1" in
		-L) follow="-L"; shift ;;
		-Lc) follow="-L"; fmt="$2"; shift 2 ;;
		-Lc*) follow="-L"; fmt="${1#-Lc}"; shift ;;
		-c) fmt="$2"; shift 2 ;;
		-c*) fmt="${1#-c}"; shift ;;
		--format=*) fmt="${1#--format=}"; shift ;;
		--format) fmt="$2"; shift 2 ;;
		--) shift; break ;;
		-*) shift ;;
		*) break ;;
	esac
done
bsd=$(printf '%s' "$fmt" | sed -e 's/%Y/%m/g' -e 's/%s/%z/g' -e 's/%a/%Lp/g')
exec "$real" $follow -f "$bsd" "$@"
SHIM

# md5sum: FreeBSD has md5(1) in /sbin. Emit GNU's "<hash>  <file>" (or "  -" for
# stdin); Omarchy only reads the first field. Absolute path: /sbin may be off PATH.
write_shim md5sum <<'SHIM'
#!/bin/sh
if [ "$#" -eq 0 ]; then
	printf '%s  -\n' "$(/sbin/md5 -q)"
else
	for f in "$@"; do printf '%s  %s\n' "$(/sbin/md5 -q "$f")" "$f"; done
fi
SHIM

# nproc: absent in FreeBSD base; report the CPU count via sysctl (/sbin).
write_shim nproc <<'SHIM'
#!/bin/sh
exec /sbin/sysctl -n hw.ncpu
SHIM

# awk: many omarchy-* helpers use GNU awk extensions (3-arg match(str, re, arr),
# gensub, strtonum) that FreeBSD's base one-true-awk rejects with a syntax error
# -- e.g. omarchy-menu-keybindings produces nothing. Route awk to gawk when it is
# installed, falling back to base awk otherwise.
write_shim awk <<'SHIM'
#!/bin/sh
if command -v gawk >/dev/null 2>&1; then exec gawk "$@"; fi
exec /usr/bin/awk "$@"
SHIM

# lua: some helpers (omarchy-menu-keybindings) invoke `lua` to parse the Lua
# Hyprland config. FreeBSD installs versioned binaries (lua54, ...), not an
# unversioned `lua`, so bridge to the newest available interpreter.
write_shim lua <<'SHIM'
#!/bin/sh
for l in lua54 lua55 lua53 lua51; do
	if command -v "$l" >/dev/null 2>&1; then exec "$l" "$@"; fi
done
echo "lua: no lua5x interpreter found" >&2
exit 127
SHIM

# ttfx: Omarchy's screensaver/effects renderer is the Arch `ttfx` package, which
# is TerminalTextEffects renamed. FreeBSD ships it as py-terminaltexteffects (the
# `tte` command) with identical flags, so pass straight through. If TTE is
# missing, stay alive (without exec, so our argv keeps the screensaver.txt marker
# the patched screensaver uses to find us) instead of erroring and busy-looping.
write_shim ttfx <<'SHIM'
#!/bin/sh
if command -v tte >/dev/null 2>&1; then
	exec tte "$@"
fi
echo "ttfx: TTE engine (py-terminaltexteffects) not installed" >&2
sleep 86400
SHIM

# systemd-run: Arch schedules power actions in the user manager (e.g.
# `systemd-run --user --on-active=2s systemctl reboot`) and, more importantly,
# omarchy-reminder's countdown notifications (--on-active=5m --unit=NAME).
# Strip the options, convert --on-active's systemd duration (Ns/Nm/Nh, or a
# bare number of seconds) to a sleep, and run the wrapped command detached so
# the caller keeps going (matching the async intent -- real systemd-run also
# returns immediately). When --unit is given, record the job in a small
# registry ($XDG_RUNTIME_DIR/omarchy-timer-shim/<unit>.timer: "<next-epoch-us>
# <pid>") so the systemctl shim's list-timers/stop can fake enough of the
# systemd timer API for omarchy-reminder show/clear to work.
write_shim systemd-run <<'SHIM'
#!/bin/sh
TIMER_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-timer-shim"
delay=""
unit=""
while [ $# -gt 0 ]; do
	case "$1" in
		--on-active=*) delay="${1#*=}"; shift ;;
		--on-active) delay="$2"; shift 2 ;;
		--unit=*) unit="${1#*=}"; shift ;;
		--unit) unit="$2"; shift 2 ;;
		--on-calendar|--description|--slice|--uid|--gid|\
		--working-directory|-p|--property|--timer-property|--setenv|-E|-M|--machine)
			shift 2 ;;
		--property=*|--timer-property=*|--setenv=*|--description=*|\
		--slice=*|--working-directory=*) shift ;;
		--user|--system|--scope|--collect|--quiet|--pipe|--wait|--no-ask-password|\
		--no-block|--no-wall|-G|-r|--remain-after-exit) shift ;;
		--) shift; break ;;
		-*) shift ;;
		*) break ;;
	esac
done
case "$delay" in
	*h) seconds=$(( ${delay%h} * 3600 )) ;;
	*m) seconds=$(( ${delay%m} * 60 )) ;;
	*s) seconds="${delay%s}" ;;
	*[0-9]) seconds="$delay" ;;
	*) seconds=0 ;;
esac
if [ "${seconds:-0}" -gt 0 ] 2>/dev/null; then
	if [ -n "$unit" ]; then
		mkdir -p "$TIMER_DIR"
		name="${unit%.timer}"; name="${name%.service}"
		next=$(( ( $(date +%s) + seconds ) * 1000000 ))
		( sleep "$seconds"; "$@"; rm -f "$TIMER_DIR/$name.timer" ) &
		printf '%s %s\n' "$next" "$!" > "$TIMER_DIR/$name.timer"
	else
		( sleep "$seconds"; exec "$@" ) &
	fi
	exit 0
fi
exec "$@"
SHIM

# systemd-inhibit: no systemd. Drop the inhibition options, run the command.
write_shim systemd-inhibit <<'SHIM'
#!/bin/sh
while [ $# -gt 0 ]; do
	case "$1" in
		--what|--who|--why|--mode) shift 2 ;;
		--what=*|--who=*|--why=*|--mode=*|--list|--no-pager|--no-legend) shift ;;
		--) shift; break ;;
		-*) shift ;;
		*) break ;;
	esac
done
exec "$@"
SHIM

# systemctl: no systemd on FreeBSD. Map the verbs Omarchy uses:
#   power     suspend->acpiconf -s3, hibernate->-s4, reboot/poweroff->shutdown(8)
#   services  enable/disable->sysrc, start/stop/restart->service(8),
#             is-enabled/is-active->boolean checks
#   timers    list-timers/stop read the registry the systemd-run shim writes
#             (see write_shim systemd-run), so omarchy-reminder show/clear work
#   --user    other session-manager ops have no equivalent -> succeed as a no-op
# Root operations escalate via doas (the bootstrap adds nopass rules for the
# power commands so the GUI power menu works without a terminal prompt).
write_shim systemctl <<'SHIM'
#!/bin/sh
priv() {
	if [ "$(id -u)" -eq 0 ]; then "$@"
	else doas "$@"; fi
}
TIMER_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-timer-shim"
list_timers() {
	pattern="${1:-*}"
	[ -d "$TIMER_DIR" ] || return 0
	sep=""
	for f in "$TIMER_DIR"/*.timer; do
		[ -e "$f" ] || continue
		name=$(basename "$f" .timer)
		case "$name.timer" in $pattern) ;; *) continue ;; esac
		next=$(cut -d' ' -f1 "$f" 2>/dev/null)
		[ -n "$next" ] || continue
		if [ "$output" = json ]; then
			printf '%s{"unit":"%s.timer","next":%s}' "$sep" "$name" "$next"
			sep=,
		else
			printf -- '- - - - %s.timer %s.service\n' "$name" "$name"
		fi
	done
}
stop_timer() {
	name="${1%.timer}"; name="${name%.service}"
	f="$TIMER_DIR/$name.timer"
	[ -f "$f" ] || return 0
	pid=$(cut -d' ' -f2 "$f" 2>/dev/null)
	if [ -n "$pid" ]; then
		# -9 on the subshell first: a plain TERM (or killing the sleep child
		# first) lets its script resume past the interrupted `wait` and still
		# fire the notification. Only then reap the now-orphaned sleep child
		# (best-effort; a harmless stray sleep may survive the reparent race).
		kill -9 "$pid" 2>/dev/null
		pkill -P "$pid" 2>/dev/null
	fi
	rm -f "$f"
}
output=""
user=0
positional=""
while [ $# -gt 0 ]; do
	case "$1" in
		--user) user=1; shift ;;
		--output=*) output="${1#*=}"; shift ;;
		--output) output="$2"; shift 2 ;;
		--system|--now|--no-wall|--no-ask-password|--quiet|-q|--no-block|\
		--no-pager|--no-legend|--force|-f|--all|--) shift ;;
		-*) shift ;;
		*) positional="$positional $1"; shift ;;
	esac
done
set -- $positional
verb="${1:-}"; [ $# -gt 0 ] && shift
case "$verb" in
	list-timers)
		[ "$output" = json ] && printf '['
		list_timers "${1:-*}"
		[ "$output" = json ] && printf ']\n'
		exit 0 ;;
	stop)
		if [ "$user" -eq 1 ]; then
			for u in "$@"; do stop_timer "$u"; done
			exit 0
		fi ;;
esac
[ "$user" -eq 1 ] && [ "$verb" != "stop" ] && exit 0
unit="${1:-}"; unit="${unit%.service}"
case "$verb" in
	suspend)        priv acpiconf -s3; exit $? ;;
	hibernate)      priv acpiconf -s4; exit $? ;;
	reboot)         priv shutdown -r now; exit $? ;;
	poweroff|halt)  priv shutdown -p now; exit $? ;;
	daemon-reload|daemon-reexec|import-environment|set-environment|\
	unset-environment|preset|preset-all) exit 0 ;;
	is-enabled)
		[ -n "$unit" ] || exit 1
		case "$(sysrc -n "${unit}_enable" 2>/dev/null)" in
			[Yy][Ee][Ss]|[Oo][Nn]|1|[Tt][Rr][Uu][Ee]) echo enabled; exit 0 ;;
			*) echo disabled; exit 1 ;;
		esac ;;
	is-active)
		[ -n "$unit" ] || exit 1
		if service "$unit" status >/dev/null 2>&1; then echo active; exit 0
		else echo inactive; exit 3; fi ;;
	enable)  priv sysrc "${unit}_enable=YES" >/dev/null 2>&1; exit $? ;;
	disable) priv sysrc "${unit}_enable=NO"  >/dev/null 2>&1; exit $? ;;
	start|stop|restart|reload) priv service "$unit" "$verb"; exit $? ;;
	status)  [ -n "$unit" ] && { service "$unit" status; exit $?; }; exit 0 ;;
	*) exit 0 ;;
esac
SHIM

# busctl: systemd-only; no D-Bus CLI on FreeBSD. Omarchy's every desktop toast
# (reminders, battery/weather/time notices, recording-saved, ...) funnels
# through omarchy-notification-send, whose only busctl use is one shape: a
# `call org.freedesktop.Notifications ... Notify susssasa{sv}i ...`. Translate
# that one call to `gdbus call` (glib2, already pulled in by gnome-keyring) so
# omarchy-shell's notification server actually receives it. Anything else is
# unsupported (fails loudly rather than silently no-op'ing).
write_shim busctl <<'SHIM'
#!/bin/sh
while [ "${1:-}" = "--user" ] || [ "${1:-}" = "--system" ] || [ "${1:-}" = "--" ]; do
	shift
done
if [ "${1:-}" != call ]; then
	echo "busctl shim: unsupported command: ${1:-}" >&2
	exit 1
fi
shift
service="$1"; method="$4"
shift 5

if [ "$service" != org.freedesktop.Notifications ] || [ "$method" != Notify ]; then
	echo "busctl shim: unsupported call: $service $method" >&2
	exit 1
fi

# Escape a value as a single-quoted GVariant string literal.
gv_str() {
	esc=$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e "s/'/\\\\'/g")
	printf "'%s'" "$esc"
}

app_name=$(gv_str "$1"); replaces_id="$2"; app_icon=$(gv_str "$3")
headline=$(gv_str "$4"); body=$(gv_str "$5")
shift 5

nactions="$1"; shift
i=0; while [ "$i" -lt "$nactions" ]; do shift; i=$((i + 1)); done

nhints="$1"; shift
hints="{"
sep=""
i=0
while [ "$i" -lt "$nhints" ]; do
	key="$1"; type="$2"; val="$3"; shift 3
	case "$type" in
		y) gv="byte $val" ;;
		*) gv=$(gv_str "$val") ;;
	esac
	hints="${hints}${sep}$(gv_str "$key"): <$gv>"
	sep=", "
	i=$((i + 1))
done
hints="${hints}}"
expire="$1"

# The trailing "--" stops gdbus's own option parser from treating a
# negative expire_timeout (e.g. "-1", the default/no-expiry value) as an
# unrecognized flag -- without it gdbus rejects the call and prints --help.
out=$(gdbus call --session \
	--dest org.freedesktop.Notifications \
	--object-path /org/freedesktop/Notifications \
	--method org.freedesktop.Notifications.Notify \
	-- "$app_name" "$replaces_id" "$app_icon" "$headline" "$body" "[]" "$hints" "$expire") || exit $?
# gdbus prints e.g. "(uint32 42,)"; busctl's callers expect "u 42". Match
# specifically on the "uint32 " marker -- a bare digit scan would instead grab
# the "32" out of "uint32" itself.
id=$(printf '%s' "$out" | sed -n 's/.*uint32 \([0-9][0-9]*\).*/\1/p')
printf 'u %s\n' "$id"
SHIM

# date: omarchy-reminder computes fire times with GNU `date -d "+Nm"` / `-d
# "@epoch"`; FreeBSD base date has no -d at all. Route to GNU date (`gdate`,
# from sysutils/coreutils) when installed, else fall back to base date (only
# plain `date +FORMAT` calls will work without -d).
write_shim date <<'SHIM'
#!/bin/sh
if command -v gdate >/dev/null 2>&1; then exec gdate "$@"; fi
exec /bin/date "$@"
SHIM
log "Writing FreeBSD session autostart to $CONFIG_HOME/hypr/autostart.lua"
mkdir -p "$CONFIG_HOME/hypr"
cat > "$CONFIG_HOME/hypr/autostart.lua" <<'LUA'
-- FreeBSD session services (Omarchy's Arch defaults rely on systemd user units).
-- o.exec_on_start runs the command directly, without uwsm.

-- Audio: PipeWire server, PulseAudio shim, and the WirePlumber session manager.
o.exec_on_start("pipewire")
o.exec_on_start("pipewire-pulse")
o.exec_on_start("wireplumber")

-- Screen-share portal backend (the xdg-desktop-portal frontend is D-Bus
-- activated on demand). Guard against a double start.
o.exec_on_start("pgrep -x xdg-desktop-portal-hyprland >/dev/null 2>&1 || " ..
	"/usr/local/libexec/xdg-desktop-portal-hyprland")

-- One-time: add the Tailscale bar widget (left of Wi-Fi). Unlike `omarchy bar
-- put`, `omarchy plugin enable` does NOT retry if omarchy-shell (quickshell)
-- isn't listening on its IPC socket yet, so it can lose the race against the
-- shell's own startup at session launch; retry it ourselves for up to a
-- minute. Guarded by a marker file so it only runs (and touches the marker)
-- once it actually succeeds.
o.exec_on_start(
	"m=\"$HOME/.local/state/omarchy/tailscale-bar-enabled\"; " ..
	"l=\"$HOME/.local/state/omarchy/tailscale-bar-enable.log\"; " ..
	"[ -f \"$m\" ] || (mkdir -p \"$(dirname \"$m\")\"; i=0; " ..
	"while [ \"$i\" -lt 60 ]; do " ..
	"omarchy plugin enable omarchy.tailscale --before omarchy.network >\"$l\" 2>&1 " ..
	"&& { touch \"$m\"; break; }; i=$((i+1)); sleep 1; done) &"
)

-- Add your own session apps here, e.g.:
-- o.launch_on_start("my-service")
LUA

# Silence startup warnings that don't apply on FreeBSD. omarchy-session execs
# Hyprland directly (not the start-hyprland watchdog) and XDG_RUNTIME_DIR is
# /var/run/user or /tmp; append the disables to the loaded looknfeel module.
log "Disabling FreeBSD-inapplicable Hyprland warnings in $CONFIG_HOME/hypr/looknfeel.lua"
if ! grep -q 'disable_watchdog_warning' "$CONFIG_HOME/hypr/looknfeel.lua" 2>/dev/null; then
	cat >> "$CONFIG_HOME/hypr/looknfeel.lua" <<'LUA'

-- FreeBSD: no start-hyprland watchdog, non-standard XDG_RUNTIME_DIR.
hl.config({
	misc = {
		disable_watchdog_warning = true,
		disable_xdg_env_checks = true,
	},
})
LUA
fi

# Cursor theme. Omarchy sets only the cursor SIZE and relies on a system default
# cursor theme that Arch provides but FreeBSD does not, so Hyprland falls back to
# its built-in teardrop cursor. FreeBSD also installs icon/cursor themes under
# /usr/local/share/icons, which is not on the default XCursor search path. Point
# XCURSOR_PATH there and select an installed theme (prefer Adwaita).
CURSOR_THEME=""
for c in Adwaita default; do
	[ -d "/usr/local/share/icons/$c/cursors" ] && { CURSOR_THEME=$c; break; }
done
if [ -n "$CURSOR_THEME" ] && ! grep -q 'XCURSOR_PATH' "$CONFIG_HOME/hypr/looknfeel.lua" 2>/dev/null; then
	log "Setting cursor theme $CURSOR_THEME in $CONFIG_HOME/hypr/looknfeel.lua"
	cat >> "$CONFIG_HOME/hypr/looknfeel.lua" <<LUA

-- FreeBSD: cursor themes live under /usr/local/share/icons (not on the default
-- XCursor path) and no system cursor theme is set, so Hyprland shows its builtin
-- teardrop cursor. Point XCursor at those dirs and select an installed theme.
hl.env("XCURSOR_PATH", "/usr/local/share/icons:/usr/share/icons:$HOME/.local/share/icons:$HOME/.icons")
hl.env("XCURSOR_THEME", "$CURSOR_THEME")
LUA
fi

# Some FreeBSD laptops (e.g. ThinkPads) report the brightness Fn keys as plain
# F5/F6 (KEY_F5/KEY_F6) rather than XF86MonBrightness*, so Omarchy's default
# brightness binds never fire. Opt in with OMARCHY_BRIGHTNESS_FN_KEYS=1 to bind
# F5 (down) and F6 (up) to omarchy-brightness-display. Off by default: on
# hardware whose keys emit the proper XF86 keysyms this would needlessly hijack
# F5/F6. The choice is persisted to a state file (like the editor/theme
# defaults below) so it survives future re-runs: bindings.lua itself does NOT
# survive re-runs -- the config-copy step above replaces it with a fresh
# upstream copy every time, opt-in flag or not, so re-appending only on this
# run's flag would silently lose the binding the next time omarchy-setup runs
# for something unrelated.
BRIGHTNESS_FN_STATE="$HOME/.local/state/omarchy/brightness-fn-keys"
if [ "${OMARCHY_BRIGHTNESS_FN_KEYS:-0}" = 1 ]; then
	mkdir -p "$(dirname "$BRIGHTNESS_FN_STATE")"
	: > "$BRIGHTNESS_FN_STATE"
fi
if [ -f "$BRIGHTNESS_FN_STATE" ] &&
	! grep -q 'FreeBSD brightness Fn keys' "$CONFIG_HOME/hypr/bindings.lua" 2>/dev/null; then
	log "Binding F5/F6 to brightness in $CONFIG_HOME/hypr/bindings.lua"
	cat >> "$CONFIG_HOME/hypr/bindings.lua" <<'LUA'

-- FreeBSD brightness Fn keys: this machine emits KEY_F5/KEY_F6 for the
-- brightness keys instead of XF86MonBrightness*, so bind the keys it actually
-- sends. This consumes F5/F6 globally.
o.bind("F6", "Brightness up", "omarchy-brightness-display +5%", { locked = true, repeating = true })
o.bind("F5", "Brightness down", "omarchy-brightness-display 5%-", { locked = true, repeating = true })
LUA
fi

# Screen locker config. Omarchy's QuickShell lock authenticates via PAM from a
# non-root process, which FreeBSD's pam_unix cannot do; the FreeBSD override of
# omarchy-system-lock uses hyprlock instead (it auths the user's own password
# via the setuid unix-selfauth-helper, no /etc/pam.d changes). Seed a hyprlock
# config if the user has none. Not overwritten, so user edits survive.
if [ ! -e "$CONFIG_HOME/hypr/hyprlock.conf" ]; then
	log "Writing hyprlock config to $CONFIG_HOME/hypr/hyprlock.conf"
	mkdir -p "$CONFIG_HOME/hypr"
	cat > "$CONFIG_HOME/hypr/hyprlock.conf" <<'CONF'
# hyprlock configuration for Omarchy on FreeBSD (written by omarchy-setup).
general {
    hide_cursor = true
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 8
}

input-field {
    monitor =
    size = 320, 55
    outline_thickness = 2
    dots_center = true
    placeholder_text = <i>Password...</i>
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    font_size = 56
    position = 0, 120
    halign = center
    valign = center
}
CONF
fi

# 4. FreeBSD adaptations on the copied files.
log "Applying FreeBSD path/command adaptations"
# 3a. Linux FHS paths -> FreeBSD LOCALBASE.
find "$CONFIG_HOME" -type f \( -name '*.conf' -o -name '*.toml' -o -name '*.lua' \
	-o -name '*.sh' -o -name '*.qml' -o -name '*.jsonc' \) -print 2>/dev/null |
	while IFS= read -r file; do
		# /usr/bin and /usr/share belong under /usr/local on FreeBSD.
		sed -i '' -e 's,/usr/bin/,/usr/local/bin/,g' \
			-e 's,/usr/share/,/usr/local/share/,g' "$file" 2>/dev/null ||
			sed -i -e 's,/usr/bin/,/usr/local/bin/,g' \
				-e 's,/usr/share/,/usr/local/share/,g' "$file"
	done

# 3b. Shebangs: Omarchy's ~440 helper scripts are #!/bin/bash, but FreeBSD ships
# bash in LOCALBASE (/usr/local/bin/bash) with no /bin/bash. Without this every
# omarchy-* helper (the bar launcher, keybind commands, ...) fails with
# "not found", leaving only a bare cursor. Rewrite line 1 to the real bash path.
BASH_BIN="$(command -v bash 2>/dev/null || echo /usr/local/bin/bash)"
log "Rewriting #!/bin/bash shebangs -> #!$BASH_BIN in $OMARCHY_SRC"
grep -rIl --exclude-dir=.git '^#!/bin/bash' "$OMARCHY_SRC" 2>/dev/null |
	while IFS= read -r file; do
		tmp="$file.omarchytmp.$$"
		# Replace only the interpreter on line 1; keep any args after `bash`.
		sed "1s,^#!/bin/bash,#!$BASH_BIN," "$file" > "$tmp" &&
			cat "$tmp" > "$file"    # truncate-in-place keeps the exec bit
		rm -f "$tmp"
	done

# 3c. Screensaver/lock detect the effect process with `pgrep/pkill -x ttfx` and
# with `pidwait`, none of which fit FreeBSD: our ttfx shim runs TTE's `tte`
# (process name python, not ttfx), and pidwait is Linux procps. Match the effect
# by its unique input-file marker (screensaver.txt) instead, and swap pidwait
# for pkill. Done here, after the git reset above, so it survives updates.
for f in omarchy-screensaver omarchy-system-lock; do
	sv="$OMARCHY_SRC/bin/$f"
	[ -f "$sv" ] || continue
	sed -i '' -e 's/-x ttfx/-f screensaver.txt/g' -e 's/pidwait /pkill /g' "$sv" 2>/dev/null ||
		sed -i -e 's/-x ttfx/-f screensaver.txt/g' -e 's/pidwait /pkill /g' "$sv"
done

# 3d. FreeBSD helper overrides. Some omarchy-* helpers are wholly Linux-specific
# (NetworkManager, etc.). The clone's bin/ is first on PATH, so a ~/.local/bin
# shim cannot shadow an omarchy-* name; instead copy our FreeBSD reimplementations
# over the clone here, after the reset, so they persist across updates. The
# override tree is found via $OMARCHY_OVERRIDES, the installed share dir, or
# ../overrides relative to this script when run from the repo checkout.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
for ovr in "${OMARCHY_OVERRIDES:-}" \
           "/usr/local/share/omarchy-freebsd/overrides" \
           "$SCRIPT_DIR/../overrides"; do
	[ -n "$ovr" ] && [ -d "$ovr/bin" ] || continue
	log "Applying FreeBSD helper overrides from $ovr/bin"
	for f in "$ovr"/bin/*; do
		[ -f "$f" ] || continue
		base="$(basename "$f")"
		cp "$f" "$OMARCHY_SRC/bin/$base" && chmod +x "$OMARCHY_SRC/bin/$base"
	done
	break
done

# 3e. Network panel connection state. The QuickShell network panel derives its
# whole "connected" state -- kind, signal strength, the hero label and the bar
# icon -- from Quickshell.Networking, whose only backend is NetworkManager over
# D-Bus. FreeBSD has no NetworkManager, so that backend reports no devices and
# the panel showed "NOT CONNECTED" with a dead icon even while the same panel
# was displaying a live SSID, IP and real-time throughput/ping fed by
# omarchy-network-status. Fall back to that status data (root.info, from
# `omarchy-network-status --verbose`) for the connected kind and signal% when
# NetworkManager is absent. Done here, after the git reset, so it survives updates.
NETPANEL="$OMARCHY_SRC/shell/plugins/panels/network/Panel.qml"
if [ -f "$NETPANEL" ] && ! grep -q 'networkManagerAvailable && info.type' "$NETPANEL"; then
	log "Patching network panel connection state for FreeBSD (no NetworkManager)"
	# Prepend an info-derived fallback ahead of kind's "disconnected" default,
	# and swap signalStrength's -1 fallback for a dBm->percent from info.
	sed -i '' \
		-e 's|    return "disconnected"|    if (!networkManagerAvailable \&\& info.type) return info.type\
    return "disconnected"|' \
		-e 's|^    : -1$|    : (info.type === "wifi" \&\& info.signal_dbm !== undefined ? Math.max(0, Math.min(100, 2 * (parseInt(info.signal_dbm, 10) + 100))) : -1)|' \
		"$NETPANEL" 2>/dev/null ||
		sed -i \
			-e 's|    return "disconnected"|    if (!networkManagerAvailable \&\& info.type) return info.type\
    return "disconnected"|' \
			-e 's|^    : -1$|    : (info.type === "wifi" \&\& info.signal_dbm !== undefined ? Math.max(0, Math.min(100, 2 * (parseInt(info.signal_dbm, 10) + 100))) : -1)|' \
			"$NETPANEL"
fi

# The DNS provider row (DHCP/Cloudflare/Google/Custom) shells out to
# omarchy-dns, which is 100% nmcli + systemd-resolved (NetworkManager conf.d
# drop-ins, resolved.conf, pkexec) -- not worth reimplementing for FreeBSD
# (DHCP-provided DNS is fine for virtually everyone). Hide the section instead
# of leaving a switcher that silently does nothing. Column/Row exclude
# invisible children from layout, so this doesn't leave a gap. Idempotent via
# the marker comment; done post-reset so it survives updates.
if [ -f "$NETPANEL" ] && ! grep -q 'omarchy-freebsd: DNS section hidden' "$NETPANEL"; then
	log "Hiding the DNS provider section in the network panel (no NetworkManager)"
	awk '
		{ print }
		/\/\/ DNS provider selection\./ { dns = 1 }
		dns && !sep && /^[[:space:]]*PanelSeparator \{/ {
			print "        visible: false  // omarchy-freebsd: DNS section hidden"
			sep = 1
			next
		}
		dns && sep && !col && /^[[:space:]]*Column \{/ {
			print "        visible: false"
			col = 1
			dns = 0
			next
		}
	' "$NETPANEL" > "$NETPANEL.omarchytmp.$$" && mv "$NETPANEL.omarchytmp.$$" "$NETPANEL"
fi

# 3f. Audio panel. The QuickShell audio panel is built entirely on
# Quickshell.Services.Pipewire, which exposes no sink on FreeBSD (there is no
# PipeWire<->OSS bridge), so the output slider was disabled and the hero read
# "Silenced" even though the volume keys worked via mixer(8). Patch the panel to
# fall back to the OSS master -- reading state with `omarchy-audio-output-volume
# status` and writing through its absolute-set / mute-toggle -- whenever there is
# no PipeWire sink. Done after the reset so it survives updates; idempotent.
AUDIOPANEL="$OMARCHY_SRC/shell/plugins/panels/audio/Panel.qml"
if [ -f "$AUDIOPANEL" ] && ! grep -q 'ossFallback' "$AUDIOPANEL"; then
	log "Patching audio panel for FreeBSD OSS fallback (no PipeWire sink)"
	awkprog="$(mktemp 2>/dev/null || echo /tmp/omarchy-audio-panel.$$.awk)"
	cat > "$awkprog" <<'AWK'
/readonly property bool ossFallback:/ { seen = 1 }
{
  line = $0
  sub(/volumeSink\.audio\.volume : 0$/, "volumeSink.audio.volume : ossVolume", line)
  m = sub(/volumeSink\.audio\.muted : false$/, "volumeSink.audio.muted : ossMuted", line)
  sub(/readonly property bool hasOutput: !!\(volumeSink && volumeSink\.audio\)$/, "readonly property bool hasOutput: !!(volumeSink \\&\\& volumeSink.audio) || root.ossFallback", line)
  sub(/if \(!volumeSink \|\| !volumeSink\.audio\) return outputVolume$/, "if (!volumeSink || !volumeSink.audio) { var vv = Math.max(0, Math.min(1, v)); Quickshell.execDetached([\"omarchy-audio-output-volume\", String(Math.round(vv * 100))]); ossVolume = vv; ossMuted = false; return vv }", line)
  sub(/if \(volumeSink && volumeSink\.audio\) volumeSink\.audio\.muted = !volumeSink\.audio\.muted$/, "if (volumeSink \\&\\& volumeSink.audio) volumeSink.audio.muted = !volumeSink.audio.muted; else { ossMuted = !ossMuted; Quickshell.execDetached([\"omarchy-audio-output-volume\", \"mute-toggle\"]) }", line)
  sub(/if \(hasOutput\) volumeSink\.audio\.muted = mute$/, "if (hasOutput \\&\\& volumeSink \\&\\& volumeSink.audio) volumeSink.audio.muted = mute; else if (root.ossFallback) { ossMuted = !ossMuted; Quickshell.execDetached([\"omarchy-audio-output-volume\", \"mute-toggle\"]) }", line)
  sub(/enabled: !!root\.sink$/, "enabled: !!root.sink || root.ossFallback", line)
  print line
  if (m && !seen) {
    print "  // FreeBSD: PipeWire exposes no sink, so back the output slider/mute with the OSS master via mixer(8)."
    print "  property real ossVolume: 0"
    print "  property bool ossMuted: false"
    print "  readonly property bool ossFallback: !volumeSink || !volumeSink.audio"
    print "  Process { id: ossReadProc; command: [\"omarchy-audio-output-volume\", \"status\"]; stdout: StdioCollector { waitForEnd: true; onStreamFinished: { var pp = String(text).trim().split(\" \"); root.ossVolume = parseFloat(pp[0]) || 0; root.ossMuted = (pp[1] === \"on\") } } }"
    print "  Timer { interval: 500; running: root.opened && root.ossFallback; repeat: true; triggeredOnStart: true; onTriggered: ossReadProc.running = true }"
  }
}
AWK
	tmp="$AUDIOPANEL.omarchytmp.$$"
	if awk -f "$awkprog" "$AUDIOPANEL" > "$tmp" && [ -s "$tmp" ]; then
		cat "$tmp" > "$AUDIOPANEL"
	fi
	rm -f "$tmp" "$awkprog"
fi

# 3g. Browser launchers resolve the browser's .desktop file by globbing
# {~/.local,~/.nix-profile,/usr}/share/applications -- which omits FreeBSD's
# LOCALBASE (/usr/local/share/applications), so omarchy-launch-webapp and
# omarchy-launch-browser find no Exec and silently launch nothing (every
# "Learn" web link, Super+B, etc. dead). Add /usr/local to the brace list.
# Also, omarchy-launch-webapp's Chromium fallback is "chromium.desktop", but
# FreeBSD's www/chromium ships "chromium-browser.desktop" (binary `chrome`);
# rewrite it so webapps launch. Post-reset so it survives updates; idempotent.
for f in omarchy-launch-webapp omarchy-launch-browser; do
	lf="$OMARCHY_SRC/bin/$f"
	[ -f "$lf" ] || continue
	if ! grep -q ',/usr,/usr/local}/share/applications' "$lf"; then
		sed -i '' -e 's|,/usr}/share/applications|,/usr,/usr/local}/share/applications|g' "$lf" 2>/dev/null ||
			sed -i -e 's|,/usr}/share/applications|,/usr,/usr/local}/share/applications|g' "$lf"
	fi
done
WEBAPP="$OMARCHY_SRC/bin/omarchy-launch-webapp"
if [ -f "$WEBAPP" ] && grep -q '"chromium\.desktop"' "$WEBAPP"; then
	sed -i '' -e 's|"chromium\.desktop"|"chromium-browser.desktop"|g' "$WEBAPP" 2>/dev/null ||
		sed -i -e 's|"chromium\.desktop"|"chromium-browser.desktop"|g' "$WEBAPP"
fi

# 3h. File manager default. omarchy's shell `open()` function (used by e.g.
# `open .`) is just `xdg-open`, which resolves inode/directory via
# mimeapps.list; without an explicit default there's nothing to fall back on.
# Point it at nautilus (also bound to Super+Shift+F). Update-safe: lives in
# ~/.config, untouched by the clone reset.
MIMEAPPS="$CONFIG_HOME/mimeapps.list"
if command -v nautilus >/dev/null 2>&1 && ! grep -q '^inode/directory=' "$MIMEAPPS" 2>/dev/null; then
	log "Setting nautilus as the default file manager (inode/directory)"
	mkdir -p "$CONFIG_HOME"
	if [ -f "$MIMEAPPS" ] && grep -q '^\[Default Applications\]' "$MIMEAPPS"; then
		awk '{ print } /^\[Default Applications\]/ { print "inode/directory=org.gnome.Nautilus.desktop" }' \
			"$MIMEAPPS" > "$MIMEAPPS.omarchytmp.$$" && mv "$MIMEAPPS.omarchytmp.$$" "$MIMEAPPS"
	else
		{
			printf '[Default Applications]\ninode/directory=org.gnome.Nautilus.desktop\n'
			[ -f "$MIMEAPPS" ] && cat "$MIMEAPPS"
		} > "$MIMEAPPS.omarchytmp.$$"
		mv "$MIMEAPPS.omarchytmp.$$" "$MIMEAPPS"
	fi
fi

# 3i. Bar reminder indicator: upstream's onPressed only opens the "set a
# reminder" overlay when there are zero active reminders; with one already
# pending, clicking the bar icon just re-shows the existing list, with no way
# to add another (mouse users are stuck, though SUPER+CTRL+R still works).
# Make the click always open the set-reminder flow; the tooltip (on hover)
# and SUPER+CTRL+ALT+R still cover "show existing reminders". Post-reset so it
# survives updates; idempotent.
REMINDERIND="$OMARCHY_SRC/shell/plugins/bar/indicators/Reminder.qml"
if [ -f "$REMINDERIND" ] && grep -q 'reminderCount > 0.*execDetached.*"show"' "$REMINDERIND"; then
	sed -i '' -e '/if (root.reminderCount > 0) Quickshell.execDetached(\["omarchy-reminder", "show"\])/d' \
		-e 's/else root.openReminderFlow()/root.openReminderFlow()/' \
		"$REMINDERIND" 2>/dev/null || {
		sed -i -e '/if (root.reminderCount > 0) Quickshell.execDetached(\["omarchy-reminder", "show"\])/d' \
			-e 's/else root.openReminderFlow()/root.openReminderFlow()/' \
			"$REMINDERIND"
	}
	log "Bar reminder icon now always opens the set-reminder flow"
fi

# Rebrand the presentation banner (omarchy-show-logo cats $OMARCHY_PATH/logo.txt)
# to "FreeBSD". Omarchy's own FIGlet font is uppercase-only, so use figlet's
# `big` font to keep the FreeBSD casing. Skip if figlet is unavailable.
if command -v figlet >/dev/null 2>&1; then
	figlet -f big -w 120 FreeBSD > "$OMARCHY_SRC/logo.txt"
	log "Rebranded logo.txt to FreeBSD"
fi

# 4b. Screensaver branding. omarchy-screensaver renders
# ~/.config/omarchy/branding/screensaver.txt with TTE; that file is normally
# created by omarchy's first-run branding step (a systemd unit we don't run), so
# without it the screensaver's `ttfx -i .../screensaver.txt` has no input. Seed
# it from the (now FreeBSD-branded) logo.txt, matching `omarchy-branding-screensaver reset`.
if [ ! -f "$CONFIG_HOME/omarchy/branding/screensaver.txt" ] && [ -f "$OMARCHY_SRC/logo.txt" ]; then
	log "Seeding screensaver branding from logo.txt"
	mkdir -p "$CONFIG_HOME/omarchy/branding"
	cp "$OMARCHY_SRC/logo.txt" "$CONFIG_HOME/omarchy/branding/screensaver.txt"
fi

# 5. Set a default theme. Omarchy config files include
# ~/.local/state/omarchy/current/theme/{foot.ini,alacritty.toml,...}; that
# "current" tree is created by omarchy-theme-set, which upstream runs from a
# systemd first-run unit we don't have. Without it every terminal/bar config
# fails with "no such file". Run it headless+offline (no gum/hyprctl/network).
OMARCHY_THEME="${OMARCHY_THEME:-tokyo-night}"
log "Setting default theme: $OMARCHY_THEME"
OMARCHY_PATH="$OMARCHY_SRC" PATH="$OMARCHY_SRC/bin:$HOME/.local/bin:$PATH" \
	OMARCHY_THEME_HEADLESS=1 OMARCHY_THEME_OFFLINE=1 \
	"$OMARCHY_SRC/bin/omarchy-theme-set" "$OMARCHY_THEME" >/dev/null 2>&1 ||
	log "warning: could not set default theme (set it later: omarchy-theme-set $OMARCHY_THEME)"

# 5b. Prefer Emacs (Wayland-native emacs-wayland) as the default editor over
# Omarchy's Neovim. omarchy-launch-editor reads this state file; write it
# directly (headless, no notification/install path). Override with OMARCHY_EDITOR.
OMARCHY_EDITOR="${OMARCHY_EDITOR:-emacs}"
log "Setting default editor: $OMARCHY_EDITOR"
mkdir -p "$HOME/.local/state/omarchy/defaults"
printf '%s\n' "$OMARCHY_EDITOR" > "$HOME/.local/state/omarchy/defaults/editor"

# 6. Menu overrides. The QuickShell menu merges a user extension over the
# defaults by id (~/.config/omarchy/extensions/omarchy-menu.jsonc). Repoint the
# Arch "Update > Omarchy" entry (pacman/AUR) at a FreeBSD pkg upgrade. Omitting
# icon/iconFont keeps the default glyph via the merge.
log "Writing FreeBSD menu overrides to $CONFIG_HOME/omarchy/extensions/omarchy-menu.jsonc"
mkdir -p "$CONFIG_HOME/omarchy/extensions"
cat > "$CONFIG_HOME/omarchy/extensions/omarchy-menu.jsonc" <<'JSONC'
{
  // FreeBSD overrides, merged over default/omarchy/omarchy-menu.jsonc by id.
  // "Update > Omarchy" (Arch pacman/AUR) -> "Update > FreeBSD" (pkg upgrade).
  // icon = nf-linux-freebsd (beastie); iconFont "" renders it from the default
  // nerd font instead of the "omarchy" logo font the default entry uses.
  "update.omarchy": {
    "icon": "",
    "iconFont": "",
    "label": "FreeBSD",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-update-freebsd"
  },

  // Package install/remove use pacman/yay; repoint at pkg. Hide AUR (no
  // FreeBSD equivalent) by making its visibility guard always fail. Reuse the
  // beastie icon from "Update > FreeBSD" so the two FreeBSD-native pkg
  // entries read consistently instead of pacman's Arch-flavored glyph.
  "install.package": {
    "icon": "",
    "iconFont": "",
    "label": "Package",
    "action": "xdg-terminal-exec --app-id=org.omarchy.terminal omarchy-pkg-install-freebsd"
  },
  "install.aur": { "when": "false" },
  "remove.package": {
    "action": "xdg-terminal-exec --app-id=org.omarchy.terminal omarchy-pkg-remove-freebsd"
  },

  // Install/Remove > AI: every entry except Ollama is a Linux-only AUR binary
  // (Electron/AppImage desktop app with no FreeBSD build): ChatGPT Desktop,
  // Dictation (voxtype), Grok Bot, Hermes Desktop, LM Studio, T3 Code. Hide
  // them (their "disabled" check still passes on FreeBSD, so upstream would
  // leave them clickable-but-broken). Ollama IS in ports (misc/ollama, a
  // single CPU/VULKAN build with no ollama-cuda/ollama-rocm split like the AUR
  // package) so repoint its action at a pkg-based installer instead of
  // upstream's pacman-based omarchy-install-app.
  "install.ai.chatgpt": { "when": "false" },
  "install.ai.dictation": { "when": "false" },
  "install.ai.grok-bot": { "when": "false" },
  "install.ai.hermes": { "when": "false" },
  "install.ai.lm-studio": { "when": "false" },
  "install.ai.t3-code": { "when": "false" },
  "install.ai.ollama": {
    "icon": "",
    "iconFont": "",
    "label": "Ollama",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-install-ai-ollama"
  },
  "remove.ai.ollama": {
    "when": "omarchy-cmd-present ollama",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-remove-ai-ollama"
  },

  // The bar's NetworkManager panel does not work on FreeBSD. Provide a working
  // wpa_supplicant selector (scan/pick/connect via fzf) under Setup > Network.
  "setup.network.wifi": {
    "icon": "󰖩",
    "label": "Wi-Fi",
    "action": "xdg-terminal-exec --app-id=org.omarchy.terminal omarchy-wifi-freebsd"
  },

  // New "Setup > Network > Tailscale": enable tailscaled + `tailscale up` (auth
  // if needed) in a floating terminal. icon reused from upstream's
  // install.service.tailscale entry so it reads the same way across menus.
  "setup.network.tailscale": {
    "icon": "",
    "label": "Tailscale",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-network-tailscale"
  },

  // New "Setup > FreeBSD" submenu: bootstrap /usr/src and /usr/ports as git
  // checkouts (with pull.ff=only configured) so "Update > FreeBSD"
  // (omarchy-update-freebsd) can subsequently `git pull` them -- it only
  // updates those trees when they are already git checkouts, it never
  // creates them. icon = nf-linux-freebsd (beastie); iconFont "" renders it
  // from the default nerd font instead of the "omarchy" logo font.
  "setup.freebsd": {
    "icon": "",
    "iconFont": "",
    "label": "FreeBSD"
  },
  "setup.freebsd.ports": {
    "icon": "",
    "iconFont": "",
    "label": "FreeBSD Ports",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-freebsd-ports"
  },
  "setup.freebsd.src": {
    "icon": "",
    "iconFont": "",
    "label": "FreeBSD src",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-freebsd-src"
  },

  // "Learn > Omarchy" opens omarchy.org/manual (Arch/Linux-specific, not
  // relevant here); hide it by making its visibility guard always fail.
  "learn.omarchy": { "when": "false" },

  // Replace "Learn > Arch" (Arch wiki) with our own "Learn > FreeBSD": hide the
  // Arch entry and add learn.freebsd (FreeBSD Handbook). New ids are appended
  // under "learn" by the menu merge. icon = nf-linux-freebsd (beastie); iconFont
  // "" renders it from the default nerd font.
  "learn.arch": { "when": "false" },
  "learn.freebsd": {
    "icon": "",
    "iconFont": "",
    "label": "FreeBSD Handbook",
    "action": "omarchy-launch-webapp 'https://docs.freebsd.org/en/books/handbook/'"
  },

  // Replace "Learn > Neovim" (LazyVim) with "Learn > Emacs": hide the Neovim
  // entry and add learn.emacs (emacs is the preferred editor here). icon = emacs
  // glyph (nf U+F15C), from the default nerd font.
  "learn.neovim": { "when": "false" },
  "learn.emacs": {
    "icon": "",
    "label": "Emacs",
    "action": "omarchy-launch-webapp 'https://www.gnu.org/software/emacs/manual/'"
  },

  // Linux-only entries with no FreeBSD concept/tooling (their commands are
  // absent), so they would error or do nothing; hide them:
  //   style.unlock, update.config.plymouth -> Plymouth boot splash (Linux)
  //   setup.direct-boot                    -> UKI + efibootmgr direct boot (Linux)
  //   update.firmware                      -> fwupd/LVFS (no FreeBSD path)
  //   update.password.drive                -> LUKS drive encryption (FreeBSD uses GELI)
  "style.unlock": { "when": "false" },
  "setup.direct-boot": { "when": "false" },
  "update.firmware": { "when": "false" },
  "update.config.plymouth": { "when": "false" },
  "update.password.drive": { "when": "false" },

  // Setup/Remove > Security is entirely Arch/Linux-specific: fingerprint (sysfs
  // USB detection + libfprint/fprintd from pacman) and FIDO2 (pam-u2f) both edit
  // /etc/pam.d/{sudo,polkit-1} (Linux PAM stack, not FreeBSD's OpenPAM layout);
  // SSHD setup opens a UFW firewall rule (FreeBSD has none, uses pf) and manages
  // sudoers timers via systemd-run; sudoless Docker requires Docker, which isn't
  // ported here at all. None of it maps cleanly, so hide the whole section
  // (parent + every child, both Setup and Remove) rather than leave a
  // half-working submenu.
  "setup.security": { "when": "false" },
  "setup.security.fingerprint": { "when": "false" },
  "setup.security.fido2": { "when": "false" },
  "setup.security.sshd": { "when": "false" },
  "setup.security.passwordless-sudo": { "when": "false" },
  "setup.security.sudoless-docker": { "when": "false" },
  "remove.security": { "when": "false" },
  "remove.security.fingerprint": { "when": "false" },
  "remove.security.fido2": { "when": "false" },
  "remove.security.sshd": { "when": "false" },
  "remove.security.sudoless-docker": { "when": "false" },

  // Screen recording is video-only on FreeBSD (wf-recorder; no PipeWire audio
  // capture or V4L2 webcam overlay yet). Collapse the audio/webcam soundtrack
  // choices to a single "Record screen" entry; the Stop entry still works via
  // its `pgrep -f '^gpu-screen-recorder'` guard because the override renames
  // the wf-recorder process to that.
  "trigger.capture.screenrecord.no-audio": {
    "label": "Record screen",
    "when": "! pgrep -f '^gpu-screen-recorder'",
    "action": "omarchy-capture-screenrecording"
  },
  "trigger.capture.screenrecord.desktop-audio": { "when": "false" },
