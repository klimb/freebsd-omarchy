#!/bin/sh
#
# omarchy-update-freebsd — full FreeBSD system update from the Omarchy menu.
#
# Replaces the Arch-specific `omarchy-update` (pacman/AUR) on FreeBSD. Wired in
# via the user menu extension that omarchy-setup writes
# (~/.config/omarchy/extensions/omarchy-menu.jsonc -> "Update > FreeBSD").
#
# Updates, in order:
#   1. the base OS + security patches   (freebsd-update fetch install)
#   2. all installed packages           (pkg update && pkg upgrade)
#   3. the ports tree, if present       (/usr/ports)
#   4. the source tree, if present      (/usr/src)
#
# Runs as an unprivileged user, so it re-executes itself as root via doas
# (installed+configured by bootstrap/install.sh).

set -u

if [ "$(id -u)" -ne 0 ]; then
	exec doas "$0" "$@"
fi

step() { printf '\n==> %s\n' "$*"; }

# 1. Base system + security patches. --not-running-from-cron keeps it
# non-interactive (no pager, no mail). Harmless no-op on non-RELEASE systems.
step "Updating base OS and applying security patches (freebsd-update)"
freebsd-update --not-running-from-cron fetch install ||
	echo "!! freebsd-update failed or had nothing to do"

# 2. Packages.
step "Updating packages (pkg)"
{ pkg update && pkg upgrade -y; } || echo "!! pkg upgrade failed"

# 3. Ports tree (only when it is a git checkout; git is the supported method).
if [ -d /usr/ports/.git ]; then
	step "Updating ports tree (/usr/ports)"
	git -C /usr/ports pull --ff-only || echo "!! ports update failed"
elif [ -d /usr/ports ]; then
	step "/usr/ports exists but is not a git checkout; skipping"
fi

# 4. Source tree (only when it is a git checkout).
if [ -d /usr/src/.git ]; then
	step "Updating source tree (/usr/src)"
	git -C /usr/src pull --ff-only || echo "!! src update failed"
elif [ -d /usr/src ]; then
	step "/usr/src exists but is not a git checkout; skipping"
fi

step "Update complete."
