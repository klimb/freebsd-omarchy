#!/bin/sh
#
# omarchy-pkg-install-freebsd — fuzzy-pick FreeBSD packages to install.
#
# FreeBSD replacement for the pacman-based omarchy-pkg-install. Wired into the
# menu ("Install > Package") by the extension omarchy-setup writes. Escalates
# with doas (installed+configured by bootstrap/install.sh).

set -eu

sel=$(pkg rquery -a '%n' | sort -u | fzf --multi \
	--preview 'pkg search {1}' \
	--preview-label='tab: multi-select, alt-p: toggle preview' \
	--preview-label-pos='bottom' \
	--preview-window 'down:65%:wrap' \
	--bind 'alt-p:toggle-preview' \
	--color 'pointer:green,marker:green') || exit 0

[ -n "$sel" ] || exit 0

echo "$sel" | tr '\n' ' ' | xargs doas pkg install -y
